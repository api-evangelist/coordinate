{
  "opencollection": "1.0.0",
  "info": {
    "name": "Coordinate REST Comments Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Bearer",
      "value": "{{Bearer}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List vendor users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.coordinatehq.com/api/v1/list_users"
          },
          "docs": "Returns all users in the vendor. Use to discover valid manager_email_address values."
        }
      ]
    }
  ],
  "bundled": true
}