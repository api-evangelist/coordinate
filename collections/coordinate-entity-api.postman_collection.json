          "name": "Cross-entity export firehose",
          "request": {
            "name": "Cross-entity export firehose",
            "description": {
              "content": "Returns all entities of all types in the vendor account, optionally filtered by date range and type. Use for bulk sync / data warehouse extracts. Supports pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "entity"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_dt",
                  "value": "<string>",
                  "description": "ISO 8601. Only entities modified at or after this dt (alias last_modified_dt)."
                },
                {
                  "disabled": false,
                  "key": "end_dt",
                  "value": "<string>",
                  "description": "ISO 8601. Only entities modified at or before this dt."
                },
                {
                  "disabled": false,
                  "key": "entity",
                  "value": "<string>",
                  "description": "Filter to one type."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "asc",
                  "description": "Sort by last_modified_dt."
                },
                {
                  "disabled": false,
                  "key": "paginate",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
